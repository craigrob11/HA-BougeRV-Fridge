{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Choose your BougeRV fridge",
        "description": "Close the BougeRV app on your phone first: the fridge only accepts one Bluetooth connection at a time.",
        "data": {
          "address": "Fridge"
        }
      },
      "setup": {
        "title": "Set up {name}",
        "description": "Tick the box if the optional BougeRV internal battery is fitted: this adds battery level, charging and input-power sensors (changeable later under Configure).\n\nThe temperature unit is sent to the fridge, so its own display and the setpoint sliders use it. You can change it later with the Temperature unit control.",
        "data": {
          "has_battery": "Internal battery is fitted",
          "initial_unit": "Temperature unit"
        }
      }
    },
    "abort": {
      "already_configured": "This fridge is already set up.",
      "no_devices_found": "No BougeRV fridge found. Make sure it is switched on, within Bluetooth range of Home Assistant (or a Bluetooth proxy), and that the BougeRV phone app is closed."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "BougeRV options",
        "data": {
          "has_battery": "Internal battery is fitted",
          "scan_interval": "Update interval (seconds)"
        },
        "data_description": {
          "scan_interval": "How often to read the fridge. Each read briefly connects over Bluetooth, during which the phone app cannot connect."
        }
      }
    }
  },
